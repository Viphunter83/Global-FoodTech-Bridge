rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for readability and reusability
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'ADMIN';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile rules
    match /users/{userId} {
      // Users can read their own profile. Only admins write it: the profile holds
      // `role` and `companyId`, which /api/auth/session copies into auth claims,
      // so a self-writable profile would let any user promote themselves to ADMIN.
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    
    // Batch passport rules (Publicly readable, but restricted writing)
    match /batches/{batchId} {
      allow read: if true;
      
      // Only authenticated users with appropriate roles can create/update
      // Enforce company isolation: users can only modify batches belonging to their company
      allow create, update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.token.role in ['MANUFACTURER', 'LOGISTICS'] &&
        (request.resource == null || request.resource.data.companyId == request.auth.token.companyId)
      );
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
