# Global FoodTech Bridge - Environment Variables

# Frontend (Portal)
# The public API URL for the passport service (backend)
NEXT_PUBLIC_PASSPORT_SERVICE_URL=https://global-foodtech-bridge-production.up.railway.app
# The public API URL for the IoT telemetry service
NEXT_PUBLIC_IOT_SERVICE_URL=https://iot-service-production.up.railway.app
# The public API URL for the blockchain integration service
NEXT_PUBLIC_BLOCKCHAIN_SERVICE_URL=https://blockchain-service-production.up.railway.app

# Backend (Passport Service)
# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:port/dbname
# Port for the HTTP server
PORT=8080

# Deployment Secrets (Set these in Railway/Vercel Dashboard)
# RAILWAY_TOKEN=RW_...
# VERCEL_TOKEN=...
