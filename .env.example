# Global FoodTech Bridge - Environment Variables Template

# --- FRONTEND (Next.js Portal) ---

# Backend Service URLs (Railway)
NEXT_PUBLIC_BLOCKCHAIN_SERVICE_URL=https://blockchain-service-production.up.railway.app/api/v1
NEXT_PUBLIC_IOT_SERVICE_URL=https://iot-service-production.up.railway.app/api/v1
NEXT_PUBLIC_PASSPORT_SERVICE_URL=https://passport-service-production.up.railway.app/api/v1

# Firebase Configuration (Authentication & Firestore)
# Get these from Firebase Console -> Project Settings -> General -> Your Apps -> Web SDK Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Security Keys
# Internal key for backend-to-backend communication
NEXT_PUBLIC_INTERNAL_API_KEY=your_secure_internal_key

# --- BACKEND SERVICES (Railway) ---

# PostgreSQL connection string for IoT and Passport services
DATABASE_URL=postgres://user:password@host:port/dbname
PORT=8080

# Blockchain Service (Node.js/Polygon)
# Funded wallet for transaction notarization
PRIVATE_KEY=your_funded_admin_private_key
RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=0xE326362613F44383504b1bFA5Dd92C0Fc7D38471
